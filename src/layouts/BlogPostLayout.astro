---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Comment from '../components/Comment.astro';
import { formatDate, tagUrl, type SeriesNav } from '../utils/posts';
import { useTranslations, localizePath, type Lang } from '../i18n';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  /** 文章語言；介面（導覽列、返回連結、留言區）也跟著用這個語言 */
  lang: Lang;
  readingMinutes: number;
  headings: MarkdownHeading[];
  series?: SeriesNav;
  /** 這篇文章的分享預覽圖，例如 /og/system-design-ch3.png */
  ogImage: string;
}

const { title, description, pubDate, updatedDate, tags, lang, readingMinutes, headings, series, ogImage } = Astro.props;
const t = useTranslations(lang);

// 目錄只列 h2 / h3，標題少於 3 個時不顯示
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = tocHeadings.length >= 3;
---
<BaseLayout
  title={`${title} · Jerry Tsai`}
  description={description}
  lang={lang}
  translatable={false}
  ogType="article"
  publishedTime={pubDate}
  ogImage={ogImage}
>
  <Nav lang={lang} variant="page" active="blog" showLangSwitch={false} />

  <section class="sec" style="padding-top: calc(var(--nav-h) + 40px);">
    <div class="container">
      <a href={localizePath('/blog/', lang)} class="blog-back">{t('blog.backToList')}</a>
      <article class="blog-post">
        <header class="blog-post-header">
          {series && (
            <div class="blog-series-label">{series.name} · {series.index} / {series.total}</div>
          )}
          <h1 class="blog-post-title">{title}</h1>
          <div class="blog-post-meta">
            <time datetime={pubDate.toISOString()}>{formatDate(pubDate, 'long', lang)}</time>
            {updatedDate && (
              <> · {t('blog.updated')} <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate, 'long', lang)}</time></>
            )}
            {' · '}{readingMinutes} {t('blog.minRead')}
          </div>
          {tags.length > 0 && (
            <div class="blog-card-tags" style="justify-content: center; margin-top: 12px;">
              {tags.map((tag) => (
                <a href={tagUrl(tag, lang)}>{tag}</a>
              ))}
            </div>
          )}
        </header>

        {showToc && (
          <details class="blog-toc" open>
            <summary>{t('blog.toc')}</summary>
            <ol>
              {tocHeadings.map((h) => (
                <li class={`toc-depth-${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </details>
        )}

        <div class="blog-post-content">
          <slot />
        </div>

        {series && (series.prev || series.next) && (
          <nav class="blog-series-nav" aria-label={series.name}>
            {series.prev ? (
              <a href={`/blog/${series.prev.id}/`} class="blog-series-prev">
                <span class="blog-series-dir">{t('blog.seriesPrev')}</span>
                <span class="blog-series-title">{series.prev.data.title}</span>
              </a>
            ) : <span />}
            {series.next && (
              <a href={`/blog/${series.next.id}/`} class="blog-series-next">
                <span class="blog-series-dir">{t('blog.seriesNext')}</span>
                <span class="blog-series-title">{series.next.data.title}</span>
              </a>
            )}
          </nav>
        )}

        <Comment lang={lang} />
      </article>
    </div>
  </section>

  <Footer lang={lang} />
</BaseLayout>
