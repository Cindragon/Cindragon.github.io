---
interface Props {
  title: string;
  description?: string;
  /** 頁面內容的語言（影響 SEO 與螢幕閱讀器）；文章頁依文章語言傳入 */
  lang?: 'en' | 'zh-TW';
  /** 文章頁傳 'article'，其他頁面用預設的 'website' */
  ogType?: 'website' | 'article';
  /** 文章發布時間，用於 article:published_time */
  publishedTime?: Date;
  /** 分享預覽圖路徑；文章頁傳自己的標題卡片，其他頁面用全站卡片 */
  ogImage?: string;
}

const {
  title,
  description = 'Tsai Chen-Hung (Jerry) — Firmware Engineer, Algorithm Enthusiast, and Technology Builder based in Taiwan.',
  lang = 'en',
  ogType = 'website',
  publishedTime,
  ogImage = '/og/site.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const isContentLangFixed = Astro.props.lang !== undefined;

import '../styles/global.css';
---
<!DOCTYPE html>
<html lang={lang} data-content-lang={isContentLangFixed ? lang : undefined}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="generator" content={Astro.generator} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" title="Jerry Tsai · Blog" href={new URL('rss.xml', Astro.site)} />

  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Jerry Tsai" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:locale" content={lang === 'zh-TW' ? 'zh_TW' : 'en_US'} />
  {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- 只載入實際用到的字重（400/600/700/800；斜體只用在 400） -->
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;700&family=Open+Sans:ital,wght@0,400;0,600;0,700;0,800;1,400&family=IBM+Plex+Mono:ital,wght@0,400;1,400&display=swap" rel="stylesheet" />
  <title>{title}</title>
</head>
<body>
  <canvas id="bg-canvas"></canvas>
  <div id="progress-bar"></div>

  <slot />

  <script>
    import { translations } from '../i18n/index';
    type Lang = keyof typeof translations;

    let currentLang: Lang = 'en';

    function applyLang(lang: Lang) {
      currentLang = lang;
      const t = translations[lang];

      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n') as keyof typeof t;
        if (t[key] !== undefined) el.innerHTML = t[key];
      });

      const btn = document.getElementById('lang-toggle');
      if (btn) btn.textContent = lang === 'en' ? '中文' : 'EN';

      // 文章頁的 lang 代表文章內容的語言，切換介面語言時不覆蓋
      if (!document.documentElement.dataset.contentLang) {
        document.documentElement.lang = lang === 'en' ? 'en' : 'zh-TW';
      }
      try { localStorage.setItem('lang', lang); } catch {}
    }

    function initLang() {
      let saved: Lang = 'en';
      try { saved = (localStorage.getItem('lang') || 'en') as Lang; } catch {}
      if (saved !== 'en') applyLang(saved);

      const btn = document.getElementById('lang-toggle');
      if (btn) {
        btn.addEventListener('click', () => {
          applyLang(currentLang === 'en' ? 'zh' : 'en');
        });
      }
    }

    function initCanvas() {
      const canvas = document.getElementById('bg-canvas') as HTMLCanvasElement;
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      let particles: { x: number; y: number; r: number; vx: number; vy: number; opacity: number }[] = [];

      function resize() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
      }

      function createParticles() {
        particles = [];
        const count = Math.min(Math.floor((canvas.width * canvas.height) / 14000), 90);
        for (let i = 0; i < count; i++) {
          particles.push({
            x: Math.random() * canvas.width,
            y: Math.random() * canvas.height,
            r: Math.random() * 1.2 + 0.2,
            vx: (Math.random() - 0.5) * 0.14,
            vy: (Math.random() - 0.5) * 0.14,
            opacity: Math.random() * 0.1 + 0.02,
          });
        }
      }

      // 使用者開啟「減少動態效果」時只畫靜態背景，不跑動畫
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function draw() {
        ctx!.clearRect(0, 0, canvas.width, canvas.height);
        for (const p of particles) {
          if (!reduceMotion) {
            p.x += p.vx;
            p.y += p.vy;
          }
          if (p.x < 0) p.x = canvas.width;
          if (p.x > canvas.width) p.x = 0;
          if (p.y < 0) p.y = canvas.height;
          if (p.y > canvas.height) p.y = 0;

          ctx!.beginPath();
          ctx!.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx!.fillStyle = `rgba(0, 133, 161, ${p.opacity * 0.5})`;
          ctx!.fill();
        }
        if (!reduceMotion) requestAnimationFrame(draw);
      }

      let resizeTimer: ReturnType<typeof setTimeout>;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          resize();
          createParticles();
          if (reduceMotion) draw();
        }, 200);
      });

      resize();
      createParticles();
      draw();
    }

    function initNav() {
      const nav = document.getElementById('nav');
      const hamburger = document.getElementById('nav-hamburger');
      const mobileNav = document.getElementById('mobile-nav');
      const progressEl = document.getElementById('progress-bar');
      const navLinks = document.querySelectorAll('.nav-links a');
      const sections = [...document.querySelectorAll<HTMLElement>('section[id]')];

      if (!nav || !hamburger || !mobileNav || !progressEl) return;

      // 版面位置只在載入／縮放時量一次，捲動時不再讀 offsetTop（避免每次捲動都觸發 reflow）
      let sectionTops: { id: string; top: number }[] = [];
      let docH = 0;
      function measure() {
        sectionTops = sections.map(sec => ({ id: sec.id, top: sec.offsetTop }));
        docH = document.documentElement.scrollHeight - window.innerHeight;
      }

      let ticking = false;
      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          const scrollY = window.scrollY;
          nav!.classList.toggle('scrolled', scrollY > 40);
          progressEl!.style.width = (docH > 0 ? (scrollY / docH) * 100 : 0) + '%';

          let current = '';
          for (const s of sectionTops) {
            if (scrollY >= s.top - 100) current = s.id;
          }
          navLinks.forEach(a => {
            const href = a.getAttribute('href') || '';
            if (href.startsWith('#')) a.classList.toggle('active', href === '#' + current);
          });
        });
      }

      measure();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', () => { measure(); onScroll(); });
      window.addEventListener('load', () => { measure(); onScroll(); });
      // 圖片載入或語言切換會改變高度
      if ('ResizeObserver' in window) {
        new ResizeObserver(() => { measure(); onScroll(); }).observe(document.body);
      }
      onScroll();

      hamburger.addEventListener('click', () => {
        const isOpen = mobileNav.classList.toggle('open');
        hamburger.classList.toggle('open', isOpen);
        hamburger.setAttribute('aria-expanded', String(isOpen));
      });

      document.querySelectorAll('.nav-links a, .mobile-nav a').forEach(a => {
        a.addEventListener('click', e => {
          const href = a.getAttribute('href');
          if (!href || !href.startsWith('#')) return;
          e.preventDefault();
          mobileNav.classList.remove('open');
          hamburger.classList.remove('open');
          hamburger.setAttribute('aria-expanded', 'false');
          const target = document.querySelector(href);
          if (target) target.scrollIntoView({ behavior: 'smooth' });
        });
      });
    }

    function initReveal() {
      const els = document.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window)) {
        els.forEach(el => el.classList.add('visible'));
        return;
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry, i) => {
          if (!entry.isIntersecting) return;
          (entry.target as HTMLElement).style.transitionDelay = `${i * 0.07}s`;
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

      els.forEach(el => observer.observe(el));
    }

    // 這是 module script，執行時 DOM 已解析完成；先套用語言以減少英文閃一下的情況
    initLang();
    initCanvas();
    initNav();
    initReveal();
  </script>
</body>
</html>
