---
import { HTML_LANG, LANGS, localizePath, stripLangPrefix, type Lang } from '../i18n';

interface Props {
  title: string;
  description?: string;
  /** 頁面語言；文章頁傳文章本身的語言 */
  lang: Lang;
  /**
   * 這個頁面是否有另一個語言的版本（/ ↔ /zh/、/blog/ ↔ /zh/blog/ …）。
   * 有的話輸出 hreflang，讓搜尋引擎知道兩個版本是同一頁。文章頁只有一種語言，傳 false。
   */
  translatable?: boolean;
  /** 文章頁傳 'article'，其他頁面用預設的 'website' */
  ogType?: 'website' | 'article';
  /** 文章發布時間，用於 article:published_time */
  publishedTime?: Date;
  /** 分享預覽圖路徑；文章頁傳自己的標題卡片，其他頁面用全站卡片 */
  ogImage?: string;
  /** 不希望被搜尋引擎收錄的頁面（例如 404）：輸出 noindex，且不輸出 canonical / og:url */
  noindex?: boolean;
}

const {
  title,
  description = 'Tsai Chen-Hung (Jerry) — Firmware Engineer, Algorithm Enthusiast, and Technology Builder based in Taiwan.',
  lang,
  translatable = true,
  ogType = 'website',
  publishedTime,
  ogImage = '/og/site.png',
  noindex = false,
} = Astro.props;

const htmlLang = HTML_LANG[lang];
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

const fontsHref =
  'https://fonts.googleapis.com/css2' +
  '?family=Open+Sans:ital,wght@0,400;0,600;0,700;0,800;1,400' +
  '&family=IBM+Plex+Mono:ital,wght@0,400;1,400' +
  '&display=swap';
// text= 會套用到同一個請求的所有字體，所以「蔡鎮鴻」的子集要分開請求
const nameFontHref =
  `https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@700&text=${encodeURIComponent('蔡鎮鴻')}&display=swap`;

const basePath = stripLangPrefix(Astro.url.pathname);
const alternates = translatable
  ? LANGS.map((l) => ({ hreflang: HTML_LANG[l], href: new URL(localizePath(basePath, l), Astro.site) }))
  : [];

import '../styles/global.css';
---
<!DOCTYPE html>
<html lang={htmlLang} data-ui-lang={lang} data-translatable={translatable ? '' : undefined}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="generator" content={Astro.generator} />
  <!--
    深淺色主題：在頁面畫出來之前就套用使用者選過的主題，避免先閃一下白色再變深色。
    沒選過時不設定 data-theme，由 CSS 的 prefers-color-scheme 跟著系統。
  -->
  <script is:inline>
    try {
      var savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'light' || savedTheme === 'dark') document.documentElement.dataset.theme = savedTheme;
    } catch (e) {}
  </script>
  <meta name="theme-color" content="#f5f5f5" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#1a1e22" media="(prefers-color-scheme: dark)" />
  {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}
  {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
  {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" title="Jerry Tsai · Blog" href={new URL('rss.xml', Astro.site)} />

  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Jerry Tsai" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {!noindex && <meta property="og:url" content={canonicalURL} />}
  <meta property="og:locale" content={lang === 'zh' ? 'zh_TW' : 'en_US'} />
  {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!--
    字體：
    - Open Sans / IBM Plex Mono：只載入用到的字重（400/600/700/800；斜體只用在 400）
    - Noto Sans TC：只下載首頁大標「蔡鎮鴻」三個字（text= 子集），其他中文用系統字體
    兩者合計只有約 80KB，用一般（會阻擋繪製）的 stylesheet 載入反而比較快：
    實測非同步載入時首次繪製較早，但字體晚到造成重繪，LCP 從 1.4s 變 2.6s。
  -->
  <link rel="stylesheet" href={fontsHref} />
  <link rel="stylesheet" href={nameFontHref} />
  <title>{title}</title>
</head>
<body>
  <canvas id="bg-canvas"></canvas>
  <div id="progress-bar"></div>

  <slot />

  <script>
    /**
     * 語言已經在 build 時決定（/ 是英文、/zh/ 是中文），這裡只負責記住訪客的選擇：
     * - 點語言切換時記下偏好
     * - 從站外直接進到「有另一語言版本」的頁面時，如果偏好的語言不同，就導到偏好的語言版本
     *   （站內換頁不導，避免來回跳；搜尋引擎沒有 localStorage，所以不受影響）
     */
    function initLang() {
      const html = document.documentElement;
      const pageLang = html.dataset.uiLang;
      const toggle = document.getElementById('lang-toggle') as HTMLAnchorElement | null;

      toggle?.addEventListener('click', () => {
        try { localStorage.setItem('lang', pageLang === 'zh' ? 'en' : 'zh'); } catch {}
      });

      if (!toggle || html.dataset.translatable === undefined) return;
      let saved: string | null = null;
      try { saved = localStorage.getItem('lang'); } catch {}
      const cameFromThisSite = document.referrer.startsWith(location.origin);
      if (saved && saved !== pageLang && !cameFromThisSite) {
        location.replace(toggle.href + location.hash);
      }
    }

    function initCanvas() {
      const canvas = document.getElementById('bg-canvas') as HTMLCanvasElement;
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      let particles: { x: number; y: number; r: number; vx: number; vy: number; opacity: number }[] = [];

      function resize() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
      }

      function createParticles() {
        particles = [];
        const count = Math.min(Math.floor((canvas.width * canvas.height) / 14000), 90);
        for (let i = 0; i < count; i++) {
          particles.push({
            x: Math.random() * canvas.width,
            y: Math.random() * canvas.height,
            r: Math.random() * 1.2 + 0.2,
            vx: (Math.random() - 0.5) * 0.14,
            vy: (Math.random() - 0.5) * 0.14,
            opacity: Math.random() * 0.1 + 0.02,
          });
        }
      }

      // 使用者開啟「減少動態效果」時只畫靜態背景，不跑動畫
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 粒子顏色來自 CSS 變數 --canvas-dot（深淺色主題不同），切換主題時重新讀取
      let dotRGB = '0, 133, 161';
      const readDotColor = () => {
        dotRGB = getComputedStyle(document.documentElement).getPropertyValue('--canvas-dot').trim() || dotRGB;
        if (reduceMotion) draw();
      };
      window.addEventListener('themechange', readDotColor);

      function draw() {
        ctx!.clearRect(0, 0, canvas.width, canvas.height);
        for (const p of particles) {
          if (!reduceMotion) {
            p.x += p.vx;
            p.y += p.vy;
          }
          if (p.x < 0) p.x = canvas.width;
          if (p.x > canvas.width) p.x = 0;
          if (p.y < 0) p.y = canvas.height;
          if (p.y > canvas.height) p.y = 0;

          ctx!.beginPath();
          ctx!.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx!.fillStyle = `rgba(${dotRGB}, ${p.opacity * 0.5})`;
          ctx!.fill();
        }
        if (!reduceMotion) requestAnimationFrame(draw);
      }

      let resizeTimer: ReturnType<typeof setTimeout>;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          resize();
          createParticles();
          if (reduceMotion) draw();
        }, 200);
      });

      resize();
      createParticles();
      readDotColor(); // 背景粒子在閒置時才啟動，錯過了第一次 themechange，這裡先讀一次
      if (!reduceMotion) draw();
    }

    function initNav() {
      const nav = document.getElementById('nav');
      const hamburger = document.getElementById('nav-hamburger');
      const mobileNav = document.getElementById('mobile-nav');
      const progressEl = document.getElementById('progress-bar');
      const navLinks = document.querySelectorAll('.nav-links a');
      const sections = [...document.querySelectorAll<HTMLElement>('section[id]')];

      if (!nav || !hamburger || !mobileNav || !progressEl) return;

      // 版面位置只在版面變動後量一次，而且延到下一個 animation frame 才讀（那時瀏覽器本來就要排版），
      // 避免在載入期間同步讀 offsetTop 造成強制重排（forced reflow）
      let sectionTops: { id: string; top: number }[] = [];
      let docH = 0;
      let dirty = true;
      function measure() {
        sectionTops = sections.map(sec => ({ id: sec.id, top: sec.offsetTop }));
        docH = document.documentElement.scrollHeight - window.innerHeight;
        dirty = false;
      }
      function invalidate() {
        dirty = true;
        onScroll();
      }

      let ticking = false;
      function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          if (dirty) measure();
          const scrollY = window.scrollY;
          nav!.classList.toggle('scrolled', scrollY > 40);
          progressEl!.style.width = (docH > 0 ? (scrollY / docH) * 100 : 0) + '%';

          let current = '';
          for (const s of sectionTops) {
            if (scrollY >= s.top - 100) current = s.id;
          }
          navLinks.forEach(a => {
            const href = a.getAttribute('href') || '';
            if (href.startsWith('#')) a.classList.toggle('active', href === '#' + current);
          });
        });
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', invalidate);
      window.addEventListener('load', invalidate);
      // 圖片、字體載入會改變高度：只標記需要重新量測，不在 callback 裡直接讀版面
      if ('ResizeObserver' in window) {
        new ResizeObserver(invalidate).observe(document.body);
      }
      onScroll();

      hamburger.addEventListener('click', () => {
        const isOpen = mobileNav.classList.toggle('open');
        hamburger.classList.toggle('open', isOpen);
        hamburger.setAttribute('aria-expanded', String(isOpen));
      });

      document.querySelectorAll('.nav-links a, .mobile-nav a').forEach(a => {
        a.addEventListener('click', e => {
          const href = a.getAttribute('href');
          if (!href || !href.startsWith('#')) return;
          e.preventDefault();
          mobileNav.classList.remove('open');
          hamburger.classList.remove('open');
          hamburger.setAttribute('aria-expanded', 'false');
          const target = document.querySelector(href);
          if (target) target.scrollIntoView({ behavior: 'smooth' });
        });
      });
    }

    function initReveal() {
      const els = document.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window)) {
        els.forEach(el => el.classList.add('visible'));
        return;
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry, i) => {
          if (!entry.isIntersecting) return;
          (entry.target as HTMLElement).style.transitionDelay = `${i * 0.07}s`;
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

      els.forEach(el => observer.observe(el));
    }

    /**
     * 深淺色切換：
     * - 沒按過按鈕：跟著系統設定（<html> 沒有 data-theme）
     * - 按過：寫入 data-theme 與 localStorage（<head> 的 inline script 下次載入時會先套用）
     * 主題改變時發出 themechange 事件，讓背景粒子、Giscus 留言區跟著換色
     */
    function initTheme() {
      const html = document.documentElement;
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
      const current = () => html.dataset.theme ?? (systemDark.matches ? 'dark' : 'light');
      const toggle = document.getElementById('theme-toggle');

      const sync = () => {
        toggle?.setAttribute('aria-pressed', String(current() === 'dark'));
        window.dispatchEvent(new CustomEvent('themechange', { detail: current() }));
      };

      toggle?.addEventListener('click', () => {
        const next = current() === 'dark' ? 'light' : 'dark';
        html.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        sync();
      });
      systemDark.addEventListener('change', sync);
      sync();
    }

    // 這是 module script，執行時 DOM 已解析完成；先處理語言偏好，需要導向時越早越好
    initLang();
    initTheme();
    initNav();
    initReveal();

    // 背景粒子只是裝飾：等頁面載入完、瀏覽器閒下來再開始，不跟首次繪製搶主執行緒
    function whenIdle(fn: () => void) {
      const run = () =>
        'requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 2000 }) : setTimeout(fn, 200);
      if (document.readyState === 'complete') run();
      else window.addEventListener('load', run, { once: true });
    }
    whenIdle(initCanvas);
  </script>
</body>
</html>
