---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="404 · Jerry Tsai" description="Page not found">
  <Nav variant="page" />

  <section class="sec not-found" style="padding-top: calc(var(--nav-h) + 40px); min-height: 70vh;">
    <div class="container">
      <div class="sec-head">
        <h2>404</h2>
        <hr class="hr-small" />
      </div>
      <p class="not-found-text" data-i18n="notFound.text">Sorry, this page doesn’t exist or has been moved.</p>
      <div class="blog-view-all">
        <a href="/blog/" data-i18n="notFound.toBlog">Browse Articles</a>
      </div>
      <p class="not-found-home"><a href="/" data-i18n="notFound.toHome">Back to Home</a></p>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .not-found-text {
    text-align: center;
    color: var(--text-light);
    margin-bottom: 32px;
  }
  .not-found-home {
    text-align: center;
    margin-top: 20px;
    font-size: 14px;
  }
</style>
