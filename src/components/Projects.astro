---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---
<section id="projects" class="sec">
  <div class="container">
    <div class="sec-head reveal">
      <h2 set:html={t('proj.title')}></h2>
      <hr class="hr-small" />
    </div>
    <div class="proj-grid">

      <article class="proj-card reveal">
        <div class="proj-top">
          <span class="proj-date mono">Apr 2025 — Present</span>
          <div class="proj-links">
            <a href="https://leetcode.com/u/Cindragon01/" target="_blank" rel="noopener" class="proj-ext" aria-label="View LeetCode profile">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16,18 22,12 16,6"/><polyline points="8,6 2,12 8,18"/></svg>
            </a>
            <a href="https://github.com/Cindragon/Leetcode-Practice-Grind-75" target="_blank" rel="noopener" class="proj-ext" aria-label="View source on GitHub">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
            </a>
            <a href="https://cindragon.github.io/Leetcode-Practice-Grind-75/" target="_blank" rel="noopener" class="proj-ext" aria-label="Visit LeetCode portfolio page">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15,3 21,3 21,9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </div>
        </div>
        <h3 class="proj-title" set:html={t('proj1.title')}></h3>
        <p class="proj-desc" set:html={t('proj1.desc')}></p>
        <div class="proj-tags">
          <span>C++</span><span>Python</span><span>pytest</span><span>GitHub Actions</span>
        </div>
      </article>

      <article class="proj-card reveal">
        <div class="proj-top">
          <span class="proj-date mono">Aug 2023 — Sep 2023</span>
          <a href="https://github.com/Cindragon" target="_blank" rel="noopener" class="proj-ext" aria-label="View on GitHub">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15,3 21,3 21,9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        </div>
        <h3 class="proj-title" set:html={t('proj2.title')}></h3>
        <p class="proj-desc" set:html={t('proj2.desc')}></p>
        <div class="proj-tags">
          <span>C++</span><span>SFML</span><span>OOP</span><span>Game Dev</span>
        </div>
      </article>

      <article class="proj-card reveal">
        <div class="proj-top">
          <span class="proj-date mono">Apr 2021 — Dec 2022</span>
          <a href="https://drive.google.com/file/d/1P4SkIvgeZafqu9M4vuFyDhix8Alhvc8f/view?usp=drive_link" target="_blank" rel="noopener" class="proj-ext" aria-label="Visit Cool English Platform">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15,3 21,3 21,9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        </div>
        <h3 class="proj-title" set:html={t('proj3.title')}></h3>
        <p class="proj-desc" set:html={t('proj3.desc')}></p>
        <div class="proj-tags">
          <span>Project Management</span><span>Communication</span><span>Event planning</span>
        </div>
      </article>

    </div>
  </div>
</section>
