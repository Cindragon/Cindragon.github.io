---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---
<section id="experience" class="sec sec-alt">
  <div class="container">
    <div class="sec-head reveal">
      <h2 set:html={t('exp.title')}></h2>
      <hr class="hr-small" />
    </div>
    <div class="timeline">

      <div class="tl-item reveal">
        <div class="tl-dot"></div>
        <div class="tl-body">
          <div class="tl-meta">
            <span class="tl-badge badge-work" set:html={t('exp.badge.work')}></span>
            <span class="tl-date mono">Nov 2025 — Mar 2026</span>
          </div>
          <h3 class="tl-title" set:html={t('exp1.title')}></h3>
          <p class="tl-org" set:html={t('exp1.org')}></p>
          <ul class="tl-list">
            <li set:html={t('exp1.li1')}></li>
            <li set:html={t('exp1.li2')}></li>
            <li set:html={t('exp1.li3')}></li>
            <li set:html={t('exp1.li4')}></li>
          </ul>
        </div>
      </div>

      <div class="tl-item reveal">
        <div class="tl-dot"></div>
        <div class="tl-body">
          <div class="tl-meta">
            <span class="tl-badge badge-work" set:html={t('exp.badge.work')}></span>
            <span class="tl-date mono">Apr 2021 — Dec 2022</span>
          </div>
          <h3 class="tl-title" set:html={t('exp2.title')}></h3>
          <p class="tl-org" set:html={t('exp2.org')}></p>
          <ul class="tl-list">
            <li set:html={t('exp2.li1')}></li>
            <li set:html={t('exp2.li2')}></li>
            <li set:html={t('exp2.li3')}></li>
            <li set:html={t('exp2.li4')}></li>
          </ul>
        </div>
      </div>

      <div class="tl-item reveal">
        <div class="tl-dot"></div>
        <div class="tl-body">
          <div class="tl-meta">
            <span class="tl-badge badge-edu" set:html={t('exp.badge.edu')}></span>
            <span class="tl-date mono">Sep 2023 — Jun 2025</span>
          </div>
          <h3 class="tl-title" set:html={t('edu1.title')}></h3>
          <p class="tl-org" set:html={t('edu1.org')}></p>
        </div>
      </div>

      <div class="tl-item reveal">
        <div class="tl-dot"></div>
        <div class="tl-body">
          <div class="tl-meta">
            <span class="tl-badge badge-edu" set:html={t('exp.badge.edu')}></span>
            <span class="tl-date mono">Sep 2016 — Jun 2020</span>
          </div>
          <h3 class="tl-title" set:html={t('edu2.title')}></h3>
          <p class="tl-org" set:html={t('edu2.org')}></p>
        </div>
      </div>

    </div>
  </div>
</section>
