---
import {
  useTranslations,
  localizePath,
  stripLangPrefix,
  LANG_LABEL,
  HTML_LANG,
  type Lang,
  type TranslationKey,
} from '../i18n';

interface Props {
  lang: Lang;
  /** home：首頁各區塊的錨點；page：其他頁面的 Home / Blog */
  variant?: 'home' | 'page';
  /** 目前所在頁面，對應的連結會標示 active */
  active?: 'blog';
  /**
   * 是否顯示語言切換。文章只有一種語言、沒有另一語言的版本，所以文章頁不顯示。
   */
  showLangSwitch?: boolean;
}

const { lang, variant = 'home', active, showLangSwitch = true } = Astro.props;
const t = useTranslations(lang);

type NavLink = { href: string; key: TranslationKey; id?: 'blog' };

const homeLinks: NavLink[] = [
  { href: '#about', key: 'nav.about' },
  { href: '#experience', key: 'nav.experience' },
  { href: '#projects', key: 'nav.projects' },
  { href: '#skills', key: 'nav.skills' },
  { href: '#blog', key: 'nav.blog' },
  { href: '#contact', key: 'nav.contact' },
];

const pageLinks: NavLink[] = [
  { href: localizePath('/', lang), key: 'nav.home' },
  { href: localizePath('/blog/', lang), key: 'nav.blog', id: 'blog' },
];

const links = variant === 'home' ? homeLinks : pageLinks;
const brandHref = variant === 'home' ? '#hero' : localizePath('/', lang);

// 切換到另一個語言的同一頁
const otherLang: Lang = lang === 'en' ? 'zh' : 'en';
const switchHref = localizePath(stripLangPrefix(Astro.url.pathname), otherLang);
---
<nav id="nav">
  <div class="nav-inner">
    <a href={brandHref} class="nav-brand">Jerry Tsai</a>
    <ul class="nav-links" id="nav-links">
      {links.map((link) => (
        <li>
          <a href={link.href} class:list={{ active: link.id && link.id === active }}>{t(link.key)}</a>
        </li>
      ))}
    </ul>
    {showLangSwitch && (
      <a
        class="lang-toggle"
        id="lang-toggle"
        href={switchHref}
        hreflang={HTML_LANG[otherLang]}
        lang={HTML_LANG[otherLang]}
        aria-label={`${LANG_LABEL[otherLang]} – ${t('lang.switch')}`}
      >{LANG_LABEL[otherLang]}</a>
    )}
    <button class="nav-hamburger" id="nav-hamburger" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<div class="mobile-nav" id="mobile-nav">
  <ul>
    {links.map((link) => (
      <li><a href={link.href}>{t(link.key)}</a></li>
    ))}
  </ul>
</div>
