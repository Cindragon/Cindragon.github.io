---
import { useTranslations, HTML_LANG, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="giscus-wrapper">
  <h2 class="comment-title">{t('comment.title')}</h2>
  <div class="giscus"></div>
</section>

<script
  is:inline
  src="https://giscus.app/client.js"
  data-repo="Cindragon/Cindragon.github.io"
  data-repo-id="R_kgDOSuDYIw"
  data-category="Announcements"
  data-category-id="DIC_kwDOSuDYI84C-gM7"
  data-mapping="pathname"
  data-strict="0"
  data-reactions-enabled="1"
  data-emit-metadata="0"
  data-input-position="bottom"
  data-theme="light"
  data-lang={HTML_LANG[lang] === 'zh-TW' ? 'zh-TW' : 'en'}
  crossorigin="anonymous"
  async
></script>

<style>
  .giscus-wrapper {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }

  .comment-title {
    font-size: 1.4rem;
    margin-bottom: 24px;
    color: var(--text);
  }
</style>
