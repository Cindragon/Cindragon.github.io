---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---
<section id="about" class="sec">
  <div class="container">
    <div class="sec-head reveal">
      <h2 set:html={t('about.title')}></h2>
      <hr class="hr-small" />
    </div>
    <div class="about-wrap">
      <div class="about-text reveal">
        <p set:html={t('about.p1')}></p>
        <p set:html={t('about.p2')}></p>
        <p set:html={t('about.p3')}></p>
        <p set:html={t('about.p4')}></p>
      </div>
      <div class="about-stats reveal">
        <div class="stat">
          <div class="stat-n">400+</div>
          <div class="stat-l" set:html={t('about.stat.leetcode')}></div>
        </div>
        <div class="stat">
          <div class="stat-n">5+</div>
          <div class="stat-l" set:html={t('about.stat.projects')}></div>
        </div>
        <div class="stat">
          <div class="stat-n">955</div>
          <div class="stat-l" set:html={t('about.stat.toeic')}></div>
        </div>
        <div class="stat">
          <div class="stat-n">7.5</div>
          <div class="stat-l" set:html={t('about.stat.ielts')}></div>
        </div>
      </div>
    </div>
  </div>
</section>
