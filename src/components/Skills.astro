<section id="skills" class="sec sec-alt">
  <div class="container">
    <div class="sec-head reveal">
      <h2 data-i18n="skills.title">Skills &amp; Certifications</h2>
      <hr class="hr-small" />
    </div>
    <div class="skills-wrap">

      <div class="skill-cat reveal">
        <h3 data-i18n="skills.cat.lang">Programming Languages</h3>
        <div class="sk-tags">
          <span>C</span><span>C++</span><span>Python</span><span>JavaScript</span><span>SQL</span>
        </div>
      </div>

      <div class="skill-cat reveal">
        <h3 data-i18n="skills.cat.systems">Systems &amp; Tools</h3>
        <div class="sk-tags">
          <span>Linux</span>
          <span>Docker</span>
          <span>Git</span>
          <span>GitHub</span>
          <span>MySQL</span>
          <span>Azure DevOps</span>
          <span>Claude</span>
        </div>
      </div>

      <div class="skill-cat reveal">
        <h3 data-i18n="skills.cat.cert">Certificate</h3>
        <div class="sk-tags cert">
          <span>AWS Certified AI Practitioner</span>
          <span>Google Cybersecurity Certificate</span>
        </div>
      </div>

      <div class="skill-cat reveal">
        <h3 data-i18n="skills.cat.languages">Languages</h3>
        <div class="sk-tags lang">
          <span>Chinese (Native)</span>
          <span>English — TOEIC 955</span>
          <span>English — IELTS 7.5</span>
        </div>
      </div>

    </div>
  </div>
</section>
